{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["node", "vite/client"],
    "rootDirs": ["blocks", "shims"],
    "paths": {
      "@/config": ["./blocks/recipes-3.ts"],
      "@/context": ["./blocks/recipes-4.tsx"]
    }
  },
  "include": ["blocks/**/*", "shims/**/*", "live.ts"]
}
